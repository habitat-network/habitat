{
  "name": "chalk",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate-local": "CI=1 wrangler d1 migrations apply chalk --local",
    "dev": "wrangler types && pnpm db:migrate-local && vite dev",
