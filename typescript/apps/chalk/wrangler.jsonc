{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chalk",
  "main": "src/server/entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DOC", "class_name": "DocRoom" }],
  },
  // v2 deletes SapChannel: it held an outbound WebSocket to sap's /channel
  // open for its entire lifetime, and Durable Object "duration" billing
  // charges continuously for wall-clock time an object has an open
  // connection — not CPU time — regardless of how idle it is. chalk now
  // syncs doc spaces itself (src/server/sync.ts), driven by inbound space
  // notifications and the cron trigger below — ordinary momentary Worker
  // invocations.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocRoom", "SapChannel"] },
    { "tag": "v2", "deleted_classes": ["SapChannel"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chalk",
      "database_id": "d8d8fd58-088a-47c7-8c24-7ec9e6483204",
      "migrations_dir": "drizzle",
    },
  ],
  // Runs the sync passes that have come due (src/server/sync.ts's
  // runDueSpaces). Inbound space notifications and newly created spaces
  // sync straight away; this catches up everything else.
  "triggers": { "crons": ["* * * * *"] },
  // These `vars` are the real deployment's values, not local dev's — see
  // the note below on why. CHALK_SESSION_SECRET and CHALK_CREDENTIALS_KEY
  // are wrangler secrets, not vars (set with `wrangler secret put <NAME>`;
  // see README.md's deployment section), so they aren't listed here.
  //
  // Named environments (`wrangler.jsonc`'s `env.*`, `wrangler deploy --env
  // production`) don't work for this app: `@cloudflare/vite-plugin`'s
  // `vite build` bakes the *top-level* config into `dist/server/
  // wrangler.json` regardless of which `--env` `wrangler deploy` is later
  // given — confirmed by inspecting that file after a build, and by a
  // `wrangler deploy --env production --dry-run` that reported the
  // top-level (local) vars back. So the top-level config has to be the one
  // that's actually deployed, and local dev instead overrides `vars` via
  // `.dev.vars` (gitignored, see there for the local values) — the
  // reverse of the usual pattern, but the only one this build pipeline
  // supports.
  "vars": {
    "CHALK_BASE_URL": "https://chalk.habitat.network",
    "CHALK_HABITAT_URL": "https://pear.habitat.network",
  },
  "dev": { "port": 5177 },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
