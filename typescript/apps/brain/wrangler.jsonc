{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brain",
      "database_id": "57434a39-0d31-48db-8f4a-2522d07b45b6",
      "migrations_dir": "drizzle",
    },
  ],
  // These `vars` are the real deployment's values, not local dev's — same
  // reason as chalk's wrangler.jsonc: `@cloudflare/vite-plugin` bakes the
  // top-level config into the build regardless of `--env`, so local dev
  // overrides them via `.dev.vars` instead. BRAIN_SESSION_SECRET and
  // BRAIN_CREDENTIALS_KEY are wrangler secrets, not vars (see README.md).
  "vars": {
    "BRAIN_BASE_URL": "https://brain.habitat.network",
    "BRAIN_HABITAT_URL": "https://pear.habitat.network",
  },
  "dev": { "port": 5179 },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
