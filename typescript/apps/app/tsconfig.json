{
  "include": ["src/**/*", "../../globals.d.ts", "worker-configuration.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@habitat-network/habitat": ["../../habitat/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "outDir": "../../../.moon/cache/types/typescript/apps/app"
  },
  "references": [
    { "path": "../../api" },
    { "path": "../../internal" },
    { "path": "../../habitat" },
    { "path": "../../jetstream" }
  ]
}
