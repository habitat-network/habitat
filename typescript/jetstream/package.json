{
  "name": "@habitat-network/jetstream",
  "version": "0.1.0",
  "private": true,
  "description": "Follow an org's spaces as one event stream, and write records that are known to be indexed once the call returns. Shaped after @bsky/jetstream's spaces mode.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./effect": {
      "types": "./src/effect.ts",
      "import": "./src/effect.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@atproto/lex-json": "0.1.10",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
