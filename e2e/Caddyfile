# TLS front for the e2e test bed (see compose.yaml). The certificate is the
# self-signed one in certs/; pear trusts it too so it can fetch
# the web client's OAuth metadata over HTTPS.
{
	admin off
	auto_https off
}

https://app.habitat-e2e.dev {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy frontend:80
}

# The instance itself, plus the host-routed identities (DID documents, handles)
# of every org under it.
https://habitat-e2e.dev, https://*.habitat-e2e.dev {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy pear:8000
}

# The alpha PDS (compose.yaml) and its accounts' handles: each handle is its own
# host (alice.pds.habitat-e2e.dev), which the PDS answers /.well-known/atproto-did on.
https://pds.habitat-e2e.dev, https://*.pds.habitat-e2e.dev {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy pds:3000
}
