# Copy to dev.env (gitignored). docker compose reads this file for variable
# substitution and passes it to the dev containers.
#
# Optional: Compose defaults to the worktree directory name, which is normally
# enough to keep worktrees isolated. Set this only if two worktrees share one.
# COMPOSE_PROJECT_NAME=habitat-my-branch

# HTTPS port published by Caddy. Leave unset (or 443) to use
# https://frontend.local.habitat.network directly. In another worktree set e.g.
# 8443 and use https://frontend.local.habitat.network:8443 instead.
HABITAT_DEV_PORT=443

# Reserved ngrok domain for public PDS OAuth flows. Each worktree needs its own.
NGROK_DOMAIN=your-domain.ngrok.app
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Embedder / reranker / decisions on the host (reachable from containers via
# host.docker.internal). Leave blank to disable the features that need them.
HABITAT_EMBEDDER_URL=http://host.docker.internal:11434/v1/embeddings
HABITAT_EMBEDDER_MODEL=nomic-embed-text
HABITAT_EMBEDDER_DIMENSIONS=768
