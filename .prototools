proto= "0.62.3"
go = "1.27.1"
golangci-lint = "2.13.1"
moon = "2.5.6"
node = "26.7.0"
pnpm = "11.27.1"
caddy = "2.11.4"
atlas = "1.3.0"
meilisearch = "1.54.2"

[plugins.tools]
golangci-lint = "https://raw.githubusercontent.com/b4nst/proto-plugins/refs/heads/main/toml/golangci-lint.toml"
caddy = "https://raw.githubusercontent.com/moonrepo/community-plugins/master/tools/caddy.toml"
atlas = "https://raw.githubusercontent.com/crashdump/proto-tools/refs/heads/main/toml-plugins/atlas/plugin.toml"
meilisearch = "file://./.proto/plugins/meilisearch.toml"

[settings]
auto-install = true
auto-clean = true
