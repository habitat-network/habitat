.habitat

# pnpm workspace
node_modules/

#  Random files that can end up in the index
**/__debug_bin*
**/.DS_Store

# Code coverage output
coverage.out

# Bin directory
bin/

# Environment variables for development
**/*.env

# Ignore frontend build
frontend_server/build

# Ignore old frontend build pre-Tanstack
frontend/out/

# TypeScript build artifacts
*.tsbuildinfo
dist/

# Keep the embed dir for the pear UI so `//go:embed` always compiles; its built
# contents are ignored via internal/webui/dist/.gitignore.
!internal/webui/dist/

# Ignore custom node config
config/habitat.dev.yml

tmp/

.moon/cache

# We generate key.jwk and repo.db at runtime to use in the server.
/pear
cmd/pear/key.jwk
cmd/pear/repo.db
*repo.db*

# Binaries left behind by `go build ./...` run directly in a cmd/ dir
# (the intended output path is bin/, see above).
/cmd/pear/pear
/cmd/sap/sap

# Ignore custom VSCode/Cursor settings
.vscode/
.vscode/settings.json

# Ignore local claude artifacts
.claude/worktrees
.claude/settings.local.json
.cursor/rules

# Ignore git worktrees
.worktrees/

**/*.db
**/*-shm
**/*-wal

# Ignore plans + specs
./docs/