{
    "lexicon": 1,
    "id": "community.opensocial.role",
    "defs": {
        "main": {
            "type": "record",
            "description": "Declares that a role exists within the community. Lives in the community's `members` space, authored by the community DID. What actions a role authorizes is out of scope for this record.",
            "key": "any",
            "record": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 256,
                        "description": "Display name for the role, e.g. \"Admin\" or \"Moderator\"."
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "datetime"
                    }
                }
            }
        }
    }
}
