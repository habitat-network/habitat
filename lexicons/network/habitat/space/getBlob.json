{
  "lexicon": 1,
  "id": "network.habitat.space.getBlob",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a blob stored within a permissioned space, addressed by its CID. Requires read access to the space.",
      "parameters": {
        "type": "params",
        "required": ["space", "repo", "cid"],
        "properties": {
          "space": {
            "type": "string",
            "format": "at-uri",
            "description": "Reference to the space the blob belongs to."
          },
          "repo": {
            "type": "string",
            "format": "did",
            "description": "The DID of the account whose repo holds the blob."
          },
          "cid": {
            "type": "string",
            "format": "cid",
            "description": "The CID of the blob to fetch."
          }
        }
      },
      "output": {
        "encoding": "*/*"
      },
      "errors": [
        {
          "name": "BlobNotFound"
        },
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "RepoNotFound"
        },
        {
          "name": "RepoTakendown"
        },
        {
          "name": "RepoSuspended"
        },
        {
          "name": "RepoDeactivated"
        }
      ]
    }
  }
}
