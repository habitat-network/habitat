{
    "lexicon": 1,
    "id": "network.habitat.org.getProfile",
    "defs": {
        "main": {
            "type": "query",
            "description": "Get a member's profile within the authenticated caller's org. Callable by any org member.",
            "parameters": {
                "type": "params",
                "required": [
                    "did"
                ],
                "properties": {
                    "did": {
                        "type": "string",
                        "format": "did",
                        "description": "DID of the member whose profile to fetch."
                    }
                }
            },
            "output": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "did",
                        "handle"
                    ],
                    "properties": {
                        "did": {
                            "type": "string",
                            "format": "did"
                        },
                        "handle": {
                            "type": "string"
                        },
                        "displayName": {
                            "type": "string"
                        },
                        "bio": {
                            "type": "string"
                        },
                        "avatarUrl": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
