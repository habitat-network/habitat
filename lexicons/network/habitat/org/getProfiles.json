{
    "lexicon": 1,
    "id": "network.habitat.org.getProfiles",
    "defs": {
        "main": {
            "type": "query",
            "description": "Get the profiles of several members within the authenticated caller's org. Callable by any org member. Members with no profile record set are omitted from the response.",
            "parameters": {
                "type": "params",
                "required": [
                    "dids"
                ],
                "properties": {
                    "dids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "did"
                        },
                        "maxLength": 100,
                        "description": "DIDs of the members whose profiles to fetch."
                    }
                }
            },
            "output": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "profiles"
                    ],
                    "properties": {
                        "profiles": {
                            "type": "array",
                            "items": {
                                "type": "ref",
                                "ref": "network.habitat.org.defs#profileView"
                            }
                        }
                    }
                }
            }
        }
    }
}
