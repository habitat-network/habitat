{
  "lexicon": 1,
  "id": "network.habitat.mcp.completeAddServer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Finish configuring an MCP server previously started with addServer, once the caller has completed authorization in Nango's Connect UI. Writes the server's record to the org. Requires service-auth. Requires the mcp.configure action.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "org",
            "id",
            "name"
          ],
          "properties": {
            "org": {
              "type": "string",
              "format": "did",
              "description": "DID of the community the server belongs to."
            },
            "id": {
              "type": "string",
              "description": "The server identifier returned by addServer."
            },
            "name": {
              "type": "string",
              "maxLength": 64,
              "description": "Must match the name passed to addServer."
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "server"
          ],
          "properties": {
            "server": {
              "type": "ref",
              "ref": "network.habitat.mcp.defs#server"
            }
          }
        }
      }
    }
  }
}
