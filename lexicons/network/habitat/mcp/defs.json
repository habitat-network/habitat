{
  "lexicon": 1,
  "id": "network.habitat.mcp.defs",
  "defs": {
    "server": {
      "type": "object",
      "description": "An MCP server configured for an org.",
      "required": [
        "id",
        "name",
        "url",
        "authType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The server's identifier, unique within the org."
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The MCP server's endpoint URL."
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "authType": {
          "type": "string",
          "knownValues": [
            "none",
            "api_key"
          ],
          "description": "How users authenticate to this MCP server. \"none\" requires no per-user credential; \"api_key\" requires each user to supply a bearer token/API key."
        }
      }
    }
  }
}
