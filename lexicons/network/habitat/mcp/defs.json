{
  "lexicon": 1,
  "id": "network.habitat.mcp.defs",
  "defs": {
    "server": {
      "type": "object",
      "description": "An MCP server configured for an org.",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The server's identifier, unique within the org."
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
