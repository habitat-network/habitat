{
  "lexicon": 1,
  "id": "network.habitat.mcp.connectServer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Store the caller's credential for an org-configured MCP server, opting the caller in to using it. Callable by any org member.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "credential"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "credential": {
              "type": "string",
              "description": "The bearer token/API key to authenticate to the MCP server with.",
              "maxLength": 8192
            }
          }
        }
      }
    }
  }
}
