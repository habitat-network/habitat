{
  "lexicon": 1,
  "id": "group.opensocial.invite",
  "defs": {
    "main": {
      "type": "record",
      "description": "An invitation to join the group, written into the invitee's invites space.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["createdAt"],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime"
          },
          "message": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          }
        }
      }
    }
  }
}
