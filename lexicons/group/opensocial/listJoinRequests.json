{
  "lexicon": 1,
  "id": "group.opensocial.listJoinRequests",
  "defs": {
    "main": {
      "type": "query",
      "description": "List pending join requests. Requires auth as the group.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["requests"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "requests": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "group.opensocial.defs#joinRequest"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidCursor"
        }
      ]
    }
  }
}
